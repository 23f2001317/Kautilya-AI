# Kautilya AI Environment Configuration Example

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=3.5 FLASH

# GitHub Authentication
GITHUB_PAT=your_github_pat_here

# Next.js & Control Plane Security
ENCRYPTION_KEY="your_base64_or_hex_encryption_key_here"

# Dynamic Target Repository & Sandbox Settings
TARGET_REPO_URL=https://github.com/23f2001317/vehicle-parking-v2.git
USE_REAL_SANDBOX=true

# Webhook & Integration Credentials (Optional)
SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/url
JIRA_TOKEN=your_jira_token_here
AWS_ACCESS_KEY=your_aws_access_key_here

# API Base URL Override (Optional)
NEXT_PUBLIC_API_URL=http://localhost:8000
